const ADMIN_PASSWORD="CHANGE_THIS_PASSWORD",PROP="AFH_DB";
function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function db(){let p=PropertiesService.getScriptProperties(),id=p.getProperty(PROP);if(!id){let s=SpreadsheetApp.create("Arif Fashion House Database");id=s.getId();p.setProperty(PROP,id);init(s)}return SpreadsheetApp.openById(id)}
function init(s){let a=s.getSheets()[0];a.setName("Settings");a.appendRow(["key","value"]);let d={brand:"Arif Fashion House",hero:"Style • Quality • Reliable Service",heroSubtitle:"Trendy fashion with home delivery.",shipping:80,cod:true,advance:true,bkashNumber:"",nagadNumber:"",rocketNumber:"",facebook:"",youtube:"",warning:"আপনার অর্ডারটি নিশ্চিত করার আগে অনুগ্রহ করে পণ্য, সাইজ/কালার, ঠিকানা ও মোবাইল নম্বর ভালোভাবে যাচাই করুন।"};Object.keys(d).forEach(k=>a.appendRow([k,JSON.stringify(d[k])]));let p=s.insertSheet("Products");p.appendRow(["id","name","category","image","images","price","oldPrice","colors","sizes","description"]);p.appendRow(["demo","Premium T-Shirt","men","", "",850,1000,"Black,White","M,L,XL","Premium quality"]);let o=s.insertSheet("Orders");o.appendRow(["id","date","name","phone","address","productId","productName","qty","color","size","price","productTotal","shipping","total","payment","transactionId","status","source"])}
function settings(){let s=db().getSheetByName("Settings"),d={};s.getRange(2,1,s.getLastRow()-1,2).getValues().forEach(r=>{try{d[r[0]]=JSON.parse(r[1])}catch(e){d[r[0]]=r[1]}});return d}
function products(){let s=db().getSheetByName("Products"),a=[];if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,10).getValues().forEach(r=>a.push({id:String(r[0]),name:r[1],category:r[2],image:r[3],images:String(r[4]||"").split(","),price:+r[5],oldPrice:+r[6],colors:String(r[7]||"").split(",").filter(Boolean),sizes:String(r[8]||"").split(",").filter(Boolean),description:r[9]||""}));return a}
function orders(){let s=db().getSheetByName("Orders"),a=[];if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,18).getValues().forEach(r=>a.push({id:String(r[0]),date:r[1],name:r[2],phone:r[3],address:r[4],productId:r[5],productName:r[6],qty:r[7],color:r[8],size:r[9],price:r[10],productTotal:r[11],shipping:r[12],total:r[13],payment:r[14],transactionId:r[15],status:r[16]||"Pending",source:r[17]||"Website"}));return a.reverse()}
function doGet(e){if(e.parameter.action=="store")return out({ok:true,data:{settings:settings(),products:products()}});if(e.parameter.action=="orders")return out({ok:true,orders:orders()});return out({ok:true})}
function doPost(e){let b=JSON.parse(e.postData.contents||"{}");try{if(b.action=="login"){if(b.password!=ADMIN_PASSWORD)return out({ok:false});let t=Utilities.getUuid();PropertiesService.getScriptProperties().setProperty("TOKEN",t);return out({ok:true,token:t})}if(b.action=="createOrder"){let o=b.order,s=db().getSheetByName("Orders");s.appendRow([o.id,new Date(),o.name,o.phone,o.address,o.productId,o.productName,o.qty,o.color,o.size,o.price,o.productTotal,o.shipping,o.total,o.payment,o.transactionId,o.status,o.source]);return out({ok:true})}if(b.token!=PropertiesService.getScriptProperties().getProperty("TOKEN"))return out({ok:false,error:"Unauthorized"});if(b.action=="saveSettings"){let s=db().getSheetByName("Settings");let old=settings();Object.keys(b.settings).forEach(k=>{let found=false;for(let i=2;i<=s.getLastRow();i++)if(s.getRange(i,1).getValue()==k){s.getRange(i,2).setValue(JSON.stringify(b.settings[k]));found=true;break}if(!found)s.appendRow([k,JSON.stringify(b.settings[k])])});return out({ok:true})}if(b.action=="saveProduct"){let p=b.product,s=db().getSheetByName("Products");for(let i=2;i<=s.getLastRow();i++)if(String(s.getRange(i,1).getValue())==String(p.id)){s.getRange(i,1,1,10).setValues([[p.id,p.name,p.category,p.image,(p.images||[]).join(","),p.price,p.oldPrice,(p.colors||[]).join(","),(p.sizes||[]).join(","),p.description]]);return out({ok:true})}s.appendRow([p.id,p.name,p.category,p.image,(p.images||[]).join(","),p.price,p.oldPrice,(p.colors||[]).join(","),(p.sizes||[]).join(","),p.description]);return out({ok:true})}if(b.action=="deleteProduct"){let s=db().getSheetByName("Products");for(let i=2;i<=s.getLastRow();i++)if(String(s.getRange(i,1).getValue())==String(b.id)){s.deleteRow(i);break}return out({ok:true})}if(b.action=="updateOrder"){let s=db().getSheetByName("Orders");for(let i=2;i<=s.getLastRow();i++)if(String(s.getRange(i,1).getValue())==String(b.id)){s.getRange(i,17).setValue(b.status);break}return out({ok:true})}return out({ok:false})}catch(e){return out({ok:false,error:String(e)})}}